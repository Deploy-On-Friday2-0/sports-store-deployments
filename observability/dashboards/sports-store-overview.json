{
  "title": "Sports Store Overview",
  "uid": "sports-store-overview",
  "tags": ["sports-store", "dep-266", "dep-295"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {},
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request Rate (RPS)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (job) (rate(http_requests_total{namespace=\"sports-store\"}[5m]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "5xx Error Rate (%)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "100 * sum(rate(http_requests_total{namespace=\"sports-store\", status=\"5xx\"}[5m])) / clamp_min(sum(rate(http_requests_total{namespace=\"sports-store\"}[5m])), 1)",
          "legendFormat": "5xx %"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP Latency (p95 / p99)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"sports-store\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"sports-store\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "title": "CPU Utilization (cores)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"sports-store\", container!=\"\"}[5m]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Memory Utilization (working set)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"sports-store\", container!=\"\"})",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Redis Performance",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Memory Usage" },
            "properties": [ { "id": "unit", "value": "bytes" } ]
          },
          {
            "matcher": { "id": "byName", "options": "Max Memory" },
            "properties": [ { "id": "unit", "value": "bytes" } ]
          },
          {
            "matcher": { "id": "byName", "options": "Hit Ratio" },
            "properties": [ { "id": "unit", "value": "percent" } ]
          },
          {
            "matcher": { "id": "byName", "options": "Throughput" },
            "properties": [ { "id": "unit", "value": "ops" } ]
          },
          {
            "matcher": { "id": "byName", "options": "Active Connections" },
            "properties": [ { "id": "unit", "value": "short" } ]
          },
          {
            "matcher": { "id": "byName", "options": "Evictions" },
            "properties": [ { "id": "unit", "value": "ops" } ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(redis_memory_used_bytes{namespace=\"sports-store\"})",
          "legendFormat": "Memory Usage"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(redis_memory_max_bytes{namespace=\"sports-store\"})",
          "legendFormat": "Max Memory"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "100 * sum(rate(redis_keyspace_hits_total{namespace=\"sports-store\"}[5m])) / clamp_min(sum(rate(redis_keyspace_hits_total{namespace=\"sports-store\"}[5m])) + sum(rate(redis_keyspace_misses_total{namespace=\"sports-store\"}[5m])), 1)",
          "legendFormat": "Hit Ratio"
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(redis_commands_processed_total{namespace=\"sports-store\"}[5m]))",
          "legendFormat": "Throughput"
        },
        {
          "refId": "E",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(redis_connected_clients{namespace=\"sports-store\"})",
          "legendFormat": "Active Connections"
        },
        {
          "refId": "F",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(redis_evicted_keys_total{namespace=\"sports-store\"}[5m]))",
          "legendFormat": "Evictions"
        }
      ]
    },
    {
      "id": 7,
      "title": "MongoDB Performance",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*Memory.*" },
            "properties": [ { "id": "unit", "value": "bytes" } ]
          },
          {
            "matcher": { "id": "byName", "options": "Active Connections" },
            "properties": [ { "id": "unit", "value": "short" } ]
          },
          {
            "matcher": { "id": "byName", "options": "Availability" },
            "properties": [ { "id": "unit", "value": "short" } ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "Op Rate.*" },
            "properties": [ { "id": "unit", "value": "ops" } ]
          },
          {
            "matcher": { "id": "byName", "options": "Page Faults" },
            "properties": [ { "id": "unit", "value": "ops" } ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (type) (rate(mongodb_op_counters_total{namespace=\"sports-store\"}[5m]))",
          "legendFormat": "Op Rate ({{type}})"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(mongodb_memory_resident_bytes{namespace=\"sports-store\"})",
          "legendFormat": "Resident Memory"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(mongodb_memory_virtual_bytes{namespace=\"sports-store\"})",
          "legendFormat": "Virtual Memory"
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(mongodb_connections{namespace=\"sports-store\", state=\"current\"})",
          "legendFormat": "Active Connections"
        },
        {
          "refId": "E",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(mongodb_extra_info_page_faults_total{namespace=\"sports-store\"}[5m]))",
          "legendFormat": "Page Faults"
        },
        {
          "refId": "F",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "mongodb_up{namespace=\"sports-store\"}",
          "legendFormat": "Availability"
        }
      ]
    }
  ]
}
